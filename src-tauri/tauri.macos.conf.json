{
  "build": {
    "beforeBundleCommand": "sh src-tauri/native/build-macos-icon.sh"
  },
  "app": {
    "windows": [
      {
        "title": "\u30b9\u30b9\u5b50\u6587\u5eab",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "icon": [
      "target/macos-app-icon/AppIcon.icns"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "target/macos-app-icon/Assets.car"
      },
      "infoPlist": "native/macos-icon.plist"
    }
  }
}
