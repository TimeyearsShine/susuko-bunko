{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Susuko Bunko",
  "version": "0.13.4",
  "identifier": "com.susuko.bunko",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "スス子文庫",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
